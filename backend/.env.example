# Database
DATABASE_URL=postgresql://postgres:postgres@db:5432/geoconces
REDIS_URL=redis://redis:6379/0

# SECURITY — REQUIRED.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# In production this MUST be >=32 chars and not a placeholder; otherwise the app aborts on startup.
SECRET_KEY=REPLACE_ME_WITH_GENERATED_SECRET

# Environment: development | staging | production
ENVIRONMENT=development

# Tables are managed by Alembic. Only set to true in throwaway envs.
AUTO_CREATE_TABLES=false

# CORS — explicit origins (always honored)
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# In production, the localhost regex is ignored automatically.

# Rate limiting (slowapi). Disable only for tests.
RATE_LIMIT_ENABLED=true

# S3 (optional, falls back to local disk if empty)
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT_URL=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
